// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.shellium.app",
  "asar": true,
  "productName": "Shellium",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "build/icon.ico",
    "build/icon.png",
    "build/icon.svg",
    "LICENSE",
    "node_modules/sql.js/dist/sql-asm.js",
    "node_modules/ssh2/**/*",
    "node_modules/asn1/**/*",
    "node_modules/bcrypt-pbkdf/**/*",
    "node_modules/safer-buffer/**/*",
    "node_modules/tweetnacl/**/*"
  ],
  "afterPack": "scripts/after-pack-mac.cjs",
  "mac": {
    "icon": "build/icon.icns",
    // No Apple Developer ID yet: no signing by electron-builder, the afterPack hook signs ad hoc.
    "identity": null,
    // ssh2's optional native crypto addon is built once; keep it as is in the universal app (ssh2
    // falls back to its JavaScript code where the addon cannot load).
    "x64ArchFiles": "**/*.node",
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      }
    ],
    "artifactName": "Shellium-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "icon": "build/icon.ico",
    "signAndEditExecutable": true,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Shellium-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "license": "LICENSE",
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "icon": "build/icon.png",
    "category": "Development",
    "target": [
      "AppImage"
    ],
    "artifactName": "Shellium-Linux-${version}.${ext}"
  }
}